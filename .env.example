# ==============================================================================
# MANHWA RECAP ENGINE - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' and fill in your keys:
#   cp .env.example .env
#
# NOTE: Microsoft Edge-TTS (en-US-BrianNeural) is the DEFAULT engine.
# It is 100% FREE and requires NO API keys or subscriptions!
# ==============================================================================

# (Optional) ElevenLabs API Key for premium cloned / custom voice models
# Get your API key at: https://elevenlabs.io
ELEVENLABS_API_KEY=

# (Optional) Groq API Key for ultra-fast Whisper word-level alignment & Orpheus TTS
# Get your API key at: https://console.groq.com
GROQ_API_KEY=
